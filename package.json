{
  "name": "codex-chat-history-exporter",
  "version": "0.1.7",
  "author": "Semtea1",
  "license": "MIT",
  "displayName": "Codex Chat History Exporter",
  "publisher": "semtea1",
  "description": "Export Codex chat history from desktop, VS Code, and CLI sessions with transcript, hidden context, and tool traces.",
  "icon": "media/marketplace-icon.png",
  "keywords": [
    "codex",
    "chat",
    "export",
    "markdown",
    "history",
    "transcript"
  ],
  "main": "./dist/vscode/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Semtea1/codex-chat-history-exporter.git"
  },
  "homepage": "https://github.com/Semtea1/codex-chat-history-exporter",
  "bugs": {
    "url": "https://github.com/Semtea1/codex-chat-history-exporter/issues"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexChatExporter.openExportWizard",
    "onCommand:codexChatExporter.exportSelectedSessions",
    "onView:codexChatExporter.sessions"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexChatExporter.openExportWizard",
        "title": "Open Chat Export Wizard",
        "category": "Codex Chat Exporter"
      },
      {
        "command": "codexChatExporter.exportSelectedSessions",
        "title": "Export Selected Sessions",
        "category": "Codex Chat Exporter"
      },
      {
        "command": "codexChatExporter.refreshSessions",
        "title": "Refresh Sessions",
        "category": "Codex Chat Exporter"
      }
    ],
    "views": {
      "codexChatExporter": [
        {
          "id": "codexChatExporter.sessions",
          "name": "Codex Sessions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexChatExporter",
          "title": "Chat Export",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexChatExporter.refreshSessions",
          "when": "view == codexChatExporter.sessions",
          "group": "navigation"
        },
        {
          "command": "codexChatExporter.openExportWizard",
          "when": "view == codexChatExporter.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codexChatExporter.openExportWizard",
          "when": "view == codexChatExporter.sessions",
          "group": "inline"
        },
        {
          "command": "codexChatExporter.exportSelectedSessions",
          "when": "view == codexChatExporter.sessions",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Codex Chat History Exporter",
      "properties": {
        "codexChatExporter.codexRoot": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Override the local .codex root directory. If empty, CODEX_HOME is preferred, otherwise the extension falls back to the current user's .codex home directory."
        },
        "codexChatExporter.defaultOutputDir": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Default export root directory pre-filled in the export wizard."
        },
        "codexChatExporter.maxSessionsInWizard": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "description": "Maximum number of sessions shown in the export wizard list."
        },
        "codexChatExporter.showInternalSessions": {
          "type": "boolean",
          "default": false,
          "description": "Show internal maintenance sessions such as memory consolidation runs."
        }
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:core": "node ./node_modules/vitest/vitest.mjs run tests/core",
    "smoke": "node dist/cli/main.js",
    "desktop:prepare-assets": "node scripts/generate-desktop-icon.js",
    "desktop:dev": "npm run desktop:prepare-assets && npm run build && electron dist/desktop/main.js",
    "desktop:package": "npm run desktop:prepare-assets && npm run build && electron-builder --config electron-builder.json --win portable",
    "vscode:prepublish": "npm run build",
    "vscode:package": "npm run build && node ./node_modules/@vscode/vsce/vsce package --no-dependencies --allow-missing-repository --skip-license --out codex-chat-history-exporter.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.2.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
